# URL base da API Go (padrao: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Site key publica do Cloudflare Turnstile (CAPTCHA), usada nas telas de
# Login e Trocar Senha. E publica (nao e segredo) — a secret key correspondente
# fica somente no backend, nunca aqui. Obter em https://dash.cloudflare.com/ > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Log verbose de rastreamento no console do navegador (LOG-02), formato
# "[arquivo] [funcao] descricao". E embutido no bundle em tempo de build:
# mantenha "false" (ou ausente) em producao. Use "true" apenas em dev.
NEXT_PUBLIC_VERBOSE=false

# ECOM-02: Client ID PUBLICO do Google (o mesmo GOOGLE_CLIENT_ID da API). Vazio = botao oculto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_ID (ECOM-02): Client ID OAuth (Google Cloud > APIs e serviços >
# Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web"). Origens JS
# autorizadas: a URL do frontend (ex.: http://localhost:3000). Vazio = login
# com Google desligado. O frontend usa o mesmo valor em NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=548791850889-popifpcvctem0kcd85ldaks4jpgekpcr.apps.googleusercontent.com
